# ── Autonomous Agent Docker Configuration ──
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Tailscale auth key — get from https://login.tailscale.com/admin/settings/keys
# Generate a "Auth key" (reusable or single-use). This lets the container
# join your tailnet non-interactively.
TAILSCALE_AUTH_KEY=tskey-auth-xxxxxxxxxxxxxxxxxxxx

# Hostname for this node on your Tailscale network
TAILSCALE_HOSTNAME=lyra-agent

# ── Optional: Override model ──
# The puller will pull this model on first run
# OLLAMA_MODEL=qwen2.5:7b

# ── Optional: Self-hosted Tailscale (headscale) ──
# TAILSCALE_LOGIN_SERVER=https://your-headscale-url
